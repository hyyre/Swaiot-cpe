name: Build QWRT S10-SKY FM160 + PinPinWiFi
on:
  push:
    branches: [ master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout QWRT Source
        uses: actions/checkout@v4

      - name: 清理磁盘空间
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc
          df -h

      - name: 安装编译依赖
        run: |
          sudo apt update
          sudo apt install -y build-essential libncurses-dev gawk flex bison git libssl-dev python3 python3-pip unzip rsync wget

      - name: 拉取拼拼WiFi插件源码
        run: |
          git clone https://github.com/wiwizcom/WiFiPortal.git wiwiz-plugin
          cp -r wiwiz-plugin/dcc2-wiwiz package/
          cp -r wiwiz-plugin/wifidog-wiwiz package/
          cp -r wiwiz-plugin/eqos-master-wiwiz package/
          rm -rf wiwiz-plugin

      - name: 更新feeds
        run: |
          ./scripts/feeds update -a
          ./scripts/feeds install -a

      - name: 加载自定义配置
        run: |
          cp .config .config.bak
          make defconfig

      - name: 下载源码
        run: make download -j$(nproc)

      - name: 编译固件
        run: make -j$(nproc)

      - name: 上传固件
        uses: actions/upload-artifact@v4
        with:
          name: QWRT-S10SKY-FM160-PinPinWiFi
          path: bin/targets/ipq807x/generic/*.bin
