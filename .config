
CONFIG_TARGET_ipq807x=y
CONFIG_TARGET_ipq807x_generic=y
CONFIG_TARGET_SUBTARGET="generic"
CONFIG_TARGET_PROFILE="DEVICE_generic"

# QWRT 5.4内核 + NSS硬件加速
CONFIG_LINUX_5_4=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_sqm-scripts-nss=y

# FM160-EAU 广和通X62模组 QMI/MBIM驱动
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-qmi-wwan=y
CONFIG_PACKAGE_kmod-mbim-wwan=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_mbim-utils=y
CONFIG_PACKAGE_luci-proto-3g=y
CONFIG_PACKAGE_luci-proto-qmi=y

# ==========拼拼WiFi Wiwiz全套插件==========
CONFIG_PACKAGE_luci-app-wiwiz=y
CONFIG_PACKAGE_wifidog-wiwiz=y
CONFIG_PACKAGE_dcc2-wiwiz=y
CONFIG_PACKAGE_eqos-master-wiwiz=y
CONFIG_PACKAGE_luci-compat=y

# LuCI基础面板
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-atcommands=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-system=y
CONFIG_PACKAGE_luci-app-network=y
CONFIG_PACKAGE_luci-app-firewall=y

# 工具集
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y

# 精简，关闭大体积无用包
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_adguardhome is not set
# CONFIG_PACKAGE_samba4 is not set
